@baseUrl = http://localhost:3000
@store = chu-bay
@itemA = 6ac26bdec7ea1a1769c5af5d
@itemB = 6ac26bdec7ea1a1769c5af5e
@fixedKey = 3f6c2a1e-8b4d-4c1a-9f2e-7a5b6c8d9e01

### 1. Valid order — run TWICE, must return the same code
POST {{baseUrl}}/stores/{{store}}/orders
Content-Type: application/json

{
  "phone": "090 123 4567",
  "fulfillment": "dine_in",
  "table": "5",
  "items": [
    { "productId": "{{itemA}}", "qty": 2 },
    { "productId": "{{itemB}}", "qty": 1 },
    { "productId": "{{itemA}}", "qty": 1 }
  ],
  "idempotencyKey": "{{fixedKey}}"
}

### 2. New order (new key each time) — code increases
POST {{baseUrl}}/stores/{{store}}/orders
Content-Type: application/json

{
  "phone": "0901234567",
  "fulfillment": "takeaway",
  "table": "9",
  "items": [{ "productId": "{{itemB}}", "qty": 1, "note": "<b>hack</b> & <a href='https://x.com'>link</a>" }],
  "idempotencyKey": "{{$guid}}"
}

### 3. Unknown product -> 422
POST {{baseUrl}}/stores/{{store}}/orders
Content-Type: application/json

{
  "phone": "0901234567",
  "fulfillment": "takeaway",
  "items": [{ "productId": "64b7f0c2a1b2c3d4e5f60718", "qty": 1 }],
  "idempotencyKey": "{{$guid}}"
}