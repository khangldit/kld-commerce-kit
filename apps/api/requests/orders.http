@baseUrl = http://localhost:3000
@store = chu-bay
@itemA = 6ac26bdec7ea1a1769c5af5d
@itemB = 6ac26bdec7ea1a1769c5af5e
@fixedKey = 3f6c2a1e-8b4d-4c1a-9f2e-7a5b6c8d9e01

### 1. Dine-in now — run TWICE, must return the same code
POST {{baseUrl}}/stores/{{store}}/orders
Content-Type: application/json

{
  "phone": "090 123 4567",
  "fulfillment": "dine_in",
  "note": "[Bàn 02 Sảnh 01] ít cay",
  "items": [
    { "productId": "{{itemA}}", "qty": 2 },
    { "productId": "{{itemB}}", "qty": 1 },
    { "productId": "{{itemA}}", "qty": 1 }
  ],
  "idempotencyKey": "{{fixedKey}}"
}

### 2. Reservation (scheduledAt requires partySize) — edit the date to a future one
POST {{baseUrl}}/stores/{{store}}/orders
Content-Type: application/json

{
  "phone": "0901234567",
  "fulfillment": "dine_in",
  "scheduledAt": "2026-12-01T19:00:00+07:00",
  "partySize": 4,
  "items": [{ "productId": "{{itemB}}", "qty": 1 }],
  "idempotencyKey": "{{$guid}}"
}

### 3. Delivery (address required) — note is HTML-escaped in Telegram
POST {{baseUrl}}/stores/{{store}}/orders
Content-Type: application/json

{
  "phone": "0901234567",
  "fulfillment": "delivery",
  "address": "12 Nguyễn Trãi, Ninh Kiều, Cần Thơ",
  "note": "<b>hack</b> & <a href='https://x.com'>link</a>",
  "items": [{ "productId": "{{itemB}}", "qty": 1 }],
  "idempotencyKey": "{{$guid}}"
}

### 4. Delivery without address -> 400 VALIDATION_FAILED
POST {{baseUrl}}/stores/{{store}}/orders
Content-Type: application/json

{
  "phone": "0901234567",
  "fulfillment": "delivery",
  "items": [{ "productId": "{{itemB}}", "qty": 1 }],
  "idempotencyKey": "{{$guid}}"
}

### 5. Unknown product -> 422 PRODUCTS_UNAVAILABLE
POST {{baseUrl}}/stores/{{store}}/orders
Content-Type: application/json

{
  "phone": "0901234567",
  "fulfillment": "dine_in",
  "items": [{ "productId": "64b7f0c2a1b2c3d4e5f60718", "qty": 1 }],
  "idempotencyKey": "{{$guid}}"
}
