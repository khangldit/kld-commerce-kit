# Which store this storefront serves (matches seed/stores/<slug>.json)
STORE_SLUG=chu-bay
# Public API base URL (also add this site's origin to the API's CORS_ORIGINS)
NEXT_PUBLIC_API_URL=http://localhost:3000
# Canonical site URL, used for metadata (optional in dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
