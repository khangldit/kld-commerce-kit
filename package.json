{
  "name": "kld-commerce-kit",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=@kld/api",
    "dev:web": "turbo dev --filter=@kld/web",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "seed": "pnpm --filter @kld/shared build && pnpm --filter @kld/api seed"
  },
  "devDependencies": {
    "turbo": "^2.11.7"
  }
}
