{
  "name": "kld-commerce-kit",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @kld/shared build && pnpm --filter @kld/api start:dev",
    "dev:shared": "pnpm --filter @kld/shared dev",
    "seed": "pnpm --filter @kld/shared build && pnpm --filter @kld/api seed"
  }
}
